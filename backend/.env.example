ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://training_book:change-me@localhost:5432/training_book
JWT_ISSUER=training-book
JWT_AUDIENCE=training-book-client
JWT_PRIVATE_KEY=replace-with-a-strong-private-key
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
OFFLINE_LEASE_DAYS=30
# 设为 true 后客户端登录页会出现“注册账号”，新账号均为普通用户（无动作管理权限）
REGISTRATION_ENABLED=false
LOCAL_MEDIA_ROOT=data/media
LOCAL_MEDIA_MAX_BYTES=1073741824
